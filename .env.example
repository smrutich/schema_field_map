# LLM Provider — auto-detected from whichever credentials you set below.
# Options: openai, groq, azure, snowflake, ollama
# Leave blank to auto-detect; set explicitly to override.
LLM_PROVIDER=

# --- OpenAI ---
OPENAI_API_KEY=
# Optional: custom OpenAI-compatible base URL (vLLM, Together, etc.)
OPENAI_BASE_URL=

# --- Groq ---
GROQ_API_KEY=

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# --- Snowflake Cortex ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PAT=
SNOWFLAKE_PASSWORD=

# --- Ollama (local fallback) ---
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Models ---
ROUTING_MODEL=gpt-4o-mini
MAPPING_MODEL=gpt-4o
MAX_RETRIES=3
