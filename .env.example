# LLM Provider Selection
# Options: snowflake_cortex, openai, azure_openai, ollama
LLM_PROVIDER=azure_openai

# --- Snowflake Cortex (when LLM_PROVIDER=snowflake_cortex) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PAT=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=

# --- OpenAI (when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
# Optional: custom base URL for OpenAI-compatible endpoints (vLLM, Together, etc.)
OPENAI_BASE_URL=

# --- Azure OpenAI (when LLM_PROVIDER=azure_openai) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=

# --- Ollama (when LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Model Configuration ---
# For Azure OpenAI, set these to your deployment name(s)
ROUTING_MODEL=gpt-4o-mini
MAPPING_MODEL=gpt-4o
# Instructor retry count on validation failure
MAX_RETRIES=3
